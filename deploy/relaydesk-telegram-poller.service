[Unit]
Description=RelayDesk Telegram Bot API long poller (fans out to every active bot via asyncio in one process)
After=network-online.target relaydesk-web.service
Wants=network-online.target
Requires=relaydesk-web.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=relaydesk
WorkingDirectory=/opt/relaydesk
EnvironmentFile=/opt/relaydesk/.env.local
ExecStart=/opt/relaydesk/.venv/bin/python -u scripts/telegram_long_poll.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/relaydesk

[Install]
WantedBy=multi-user.target
